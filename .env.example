# Copy to .env and fill in. See docs/LabLend.md for free options.

# Option A: Claude via the Agent SDK. Uses your Claude plan, no API key, but
# Claude Code must be signed in on this machine (run `claude` once, then /login).
# Or set ANTHROPIC_API_KEY instead. CLAUDE_MODEL is optional.
LLM_PROVIDER=claude-sdk
# CLAUDE_MODEL=
# ANTHROPIC_API_KEY=

# Option B: any OpenAI-compatible API (leave LLM_PROVIDER unset).
# LLM_BASE_URL example: http://localhost:11434/v1 (Ollama)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# The chat's system prompt: v1 (Milestone 2) or v2 (default). See npm run eval.
# AGENT_PROMPT=v2
